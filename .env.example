# ReleasePilot AI — пример переменных окружения.
# Скопировать в .env.local и заполнить. Файл .env* в .gitignore, кроме этого.
# Ни одно реальное значение не должно попасть в репозиторий.

# ─── Режим работы (ADR-002) ────────────────────────────────────────────────
# demo       — публичный инстанс, только синтетические данные,
#              коннектор трекера недоступен технически
# corporate  — внутренний инстанс, доступ к реальному трекеру
APP_MODE=demo

# Что уходит в модель (ADR-002, ADR-003 §6):
# metrics — только посчитанные числа, тексты задач не передаются (по умолчанию)
# titles  — плюс заголовки задач
# full    — плюс описания. В режиме corporate использовать осознанно.
LLM_PAYLOAD_LEVEL=metrics

# ─── Supabase ──────────────────────────────────────────────────────────────
# Публичные: попадают в клиентский бандл, это нормально — доступ режет RLS
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Серверный ключ: обходит RLS. Никогда не NEXT_PUBLIC_, только на сервере.
SUPABASE_SERVICE_ROLE_KEY=

# Адрес для сквозной проверки `npm run smoke:auth`. Только для разработки.
# Нужен настоящий: Supabase отвергает example.com и домены .test/.local,
# а регистрировать пробного пользователя на чужой адрес недопустимо.
# Скрипт добавит метку через плюс и удалит пользователя сразу после проверки.
SMOKE_EMAIL=

# Демо-аккаунт для `npm run seed:demo`. Публикуется в README, чтобы
# проверяющий мог войти, не регистрируясь, — то есть это заведомо
# публичные значения, а не секрет. Адрес не обязателен: по умолчанию
# demo@example.com. Пароль обязателен и не короче восьми символов —
# скрипт его не выдумывает, потому что публикует его владелец проекта,
# а не скрипт (см. комментарий в scripts/seed-demo.ts).
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=

# ─── Claude API ────────────────────────────────────────────────────────────
# Только серверная переменная. Утечка в бандл = чужие расходы на нашем счёте.
ANTHROPIC_API_KEY=
# Идентификаторы точные и без суффикса даты: «claude-opus-4-7-2026…» даёт 404.
# MAIN ведёт разбор релиза, LIGHT — короткие переформулировки.
ANTHROPIC_MODEL_MAIN=claude-opus-4-7
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
# Предел обращений к агенту на пользователя в сутки
AGENT_DAILY_LIMIT=50

# ─── Планировщик ───────────────────────────────────────────────────────────
# Пароль ежедневной записи снимков метрик (FR-39). Не задан — маршрут
# /api/cron/snapshot отвечает «не настроено» и ничего не делает. Задавать
# случайной строкой не короче 16 символов: маршрут работает административным
# клиентом, в обход политик RLS.
CRON_SECRET=

# ─── Yandex Tracker (только APP_MODE=corporate) ────────────────────────────
TRACKER_OAUTH_TOKEN=
TRACKER_ORG_ID=
TRACKER_QUEUE=

# ─── Email-уведомления ─────────────────────────────────────────────────────
RESEND_API_KEY=
DIGEST_FROM_EMAIL=

# ─── Приложение ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
